// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CONSULTANT
  ADMIN
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum CarStatus {
  AVAILABLE
  BOOKED
  SOLD
}

enum LeadSource {
  WEBSITE
  TEST_DRIVE
  TRADE_IN
  PORTAL
}

enum LeadStatus {
  NEW
  CONTACTED
  TEST_DRIVE_BOOKED
  WON
  LOST
}

model City {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  state      String
  showrooms  Showroom[]
  priceRules PriceRule[]
}

model Showroom {
  id              Int              @id @default(autoincrement())
  name            String
  slug            String           @unique
  address         String
  phone           String
  cityId          Int
  city            City             @relation(fields: [cityId], references: [id])
  users           User[]
  demoCars        DemoCar[]
  usedCars        UsedCar[]
  leads           Lead[]
  testDrives      TestDrive[]
  assignmentRules AssignmentRule[]
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  passwordHash    String
  role            Role             @default(CONSULTANT)
  showroomId      Int?
  showroom        Showroom?        @relation(fields: [showroomId], references: [id])
  assignedLeads   Lead[]
  assignmentRules AssignmentRule[]
  createdAt       DateTime         @default(now())
}

model CarModel {
  id              Int              @id @default(autoincrement())
  name            String
  slug            String           @unique
  bodyType        String
  tagline         String
  variants        Variant[]
  assignmentRules AssignmentRule[]
}

model Variant {
  id              Int          @id @default(autoincrement())
  modelId         Int
  model           CarModel     @relation(fields: [modelId], references: [id])
  name            String
  slug            String       @unique
  fuel            FuelType
  transmission    Transmission
  exShowroomPrice Int
  engine          String
  powerBhp        Int
  mileageKmpl     Float
  seats           Int
  colours         String[]
  priceRules      PriceRule[]
  demoCars        DemoCar[]
  leads           Lead[]
}

model PriceRule {
  id          Int      @id @default(autoincrement())
  variantId   Int
  variant     Variant  @relation(fields: [variantId], references: [id])
  cityId      Int
  city        City     @relation(fields: [cityId], references: [id])
  roadTaxPct  Decimal  @db.Decimal(5, 2)
  insurance   Int
  accessories Int
  otherCharges Int
  validUntil  DateTime

  @@unique([variantId, cityId])
}

model UsedCar {
  id                 Int          @id @default(autoincrement())
  stockId            String       @unique
  modelName          String
  variantName        String
  fuel               FuelType
  transmission       Transmission
  year               Int
  kmDriven           Int
  owners             Int
  registrationMasked String
  colour             String
  price              Int
  status             CarStatus    @default(AVAILABLE)
  inspectionScore    Int
  inspectionNotes    String
  showroomId         Int
  showroom           Showroom     @relation(fields: [showroomId], references: [id])
  testDrives         TestDrive[]
  leads              Lead[]
  createdAt          DateTime     @default(now())

  @@index([status])
}

model DemoCar {
  id         Int         @id @default(autoincrement())
  label      String
  variantId  Int
  variant    Variant     @relation(fields: [variantId], references: [id])
  showroomId Int
  showroom   Showroom    @relation(fields: [showroomId], references: [id])
  testDrives TestDrive[]
}

model TestDrive {
  id            Int       @id @default(autoincrement())
  slotStart     DateTime
  customerName  String
  customerPhone String
  showroomId    Int
  showroom      Showroom  @relation(fields: [showroomId], references: [id])
  demoCarId     Int?
  demoCar       DemoCar?  @relation(fields: [demoCarId], references: [id])
  usedCarId     Int?
  usedCar       UsedCar?  @relation(fields: [usedCarId], references: [id])
  leadId        Int
  lead          Lead      @relation(fields: [leadId], references: [id])
  createdAt     DateTime  @default(now())

  @@unique([demoCarId, slotStart])
  @@unique([usedCarId, slotStart])
}

model Lead {
  id              Int         @id @default(autoincrement())
  name            String
  phone           String
  email           String?
  message         String?
  source          LeadSource
  status          LeadStatus  @default(NEW)
  consent         Boolean
  createdAt       DateTime    @default(now())
  respondBy       DateTime
  firstResponseAt DateTime?
  aiSummary       String?
  aiReplyDraft    String?
    aiDraftSource   String?
  showroomId      Int
  showroom        Showroom    @relation(fields: [showroomId], references: [id])
  assignedToId    Int?
  assignedTo      User?       @relation(fields: [assignedToId], references: [id])
  variantId       Int?
  variant         Variant?    @relation(fields: [variantId], references: [id])
  usedCarId       Int?
  usedCar         UsedCar?    @relation(fields: [usedCarId], references: [id])
  testDrives      TestDrive[]

  @@index([status])
  @@index([assignedToId])
}

model AssignmentRule {
  id           Int       @id @default(autoincrement())
  showroomId   Int
  showroom     Showroom  @relation(fields: [showroomId], references: [id])
  carModelId   Int?
  carModel     CarModel? @relation(fields: [carModelId], references: [id])
  consultantId Int
  consultant   User      @relation(fields: [consultantId], references: [id])
}